# Optional settings. Copy this file to .env (git-ignored): scripts/launch.py and the app read it at start-up.
# Real environment variables always win over the file. No API key is needed for a local Ollama server.
# Everything below is optional.
#
# LLM_BACKEND=auto            # auto | ollama | openai_compat | none  (none = rule-based only)
# LLM_MODEL=qwen2.5:7b        # override the automatic, device-based model choice
# LLM_BASE_URL=http://127.0.0.1:11434   # loopback only unless LLM_ALLOW_REMOTE=1
# LLM_TIMEOUT_S=120           # raise on slow CPUs
# LLM_NUM_CTX=4096
# LLM_MAX_TOKENS=900
# LLM_API_KEY=                # only for a local server that requires one; never commit it

# Direct YouTube connection (optional). Create the client yourself in Google Cloud; see docs/CONNECT_YOUTUBE.md.
# Never commit real values: .env is git-ignored.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8501/   # must match the address registered in Google Cloud exactly

# "Keep me connected" (optional, your own computer only): remember Google's read-only permission in a private file in your user folder
# (~/.signal_studio/google_connection.json) so the app opens already connected. Never use this on a shared server; it is ignored
# unless the visitor is on the same computer. Videos are never saved.
# GOOGLE_STAY_CONNECTED=1
