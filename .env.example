# Optional settings. Copy this file to .env (git-ignored): scripts/launch.py and the app read it at start-up.
# Real environment variables always win over the file. No API key is needed for a local Ollama server.
# Everything below is optional.
#
# LLM_BACKEND=auto            # auto | ollama | openai_compat | none  (none = rule-based only)
# LLM_MODEL=qwen2.5:7b        # override the automatic, device-based model choice
# LLM_BASE_URL=http://127.0.0.1:11434   # loopback only unless LLM_ALLOW_REMOTE=1
# LLM_TIMEOUT_S=120           # raise on slow CPUs
# LLM_NUM_CTX=4096
# LLM_MAX_TOKENS=900
# LLM_API_KEY=                # only for a local server that requires one; never commit it
