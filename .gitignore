venv/
__pycache__/
*.pyc
data/
# The application ships the compact, reviewed inference models. Raw datasets
# remain local because they are large and are not needed to serve predictions.
!models/
!models/*.pkl
!models/*.joblib
.ipynb_checkpoints/
logs/
.pytest_cache/
.vscode/
# Secrets and local LLM configuration must never be committed
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.key
*.pem

# Raw full-page screenshots are regenerated by scripts/capture_screens.py
deliverables/assets/screens/0*.png
deliverables/assets/screens/cropped/

# test tooling artefacts
.coverage
htmlcov/
